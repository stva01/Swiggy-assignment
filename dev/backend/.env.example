# Copy this file to .env and set the real key locally. Never commit .env.
GROQ_API_KEY=
GROQ_MAIN_MODEL=openai/gpt-oss-20b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_OUTPUT_GUARD_MODEL=openai/gpt-oss-safeguard-20b
# Keep false until the output-safety model has been evaluated against our HR test set.
GROQ_OUTPUT_GUARD_ENABLED=false
PROMPT_GUARD_REQUIRED=true
DATABASE_URL=sqlite+aiosqlite:///./post_offer_hq.db
